# Local development template - copy to `.env` in your plugin project directory and uncomment
# what you need. See docs/CLI.md#environment-variables for the full reference table.
#
# Nothing here is required - every var below has a working production default. You only need
# this file to point the CLI/SDK at something OTHER than production (a staging instance, or a
# backend running on your own machine).

NODE_ENV=development

# ── REST API (CLI commands: deploy, test, plugin make/convert/trigger, login --basic) ──────────
# Defaults to https://api.aivin.cloud if unset.
AIVIN_BASE_URL=https://beta-api.aivin.vn       # staging
# AIVIN_BASE_URL=http://localhost:3001           # local BE

# `aivin login`'s default browser flow needs the platform's web app URL (not the API).
# Defaults to https://brain.aivin.cloud if unset.
# AIVIN_WEB_URL=http://localhost:5173            # local FE

# ── gRPC SDK channel (ctx.sdk.* calls made from inside your plugin's main()) ────────────────────
# Separate host from AIVIN_BASE_URL above - this is the SDK's own outbound channel, not the REST
# API. Defaults to sdk.aivin.cloud:443 (production, behind a load balancer) if unset.
SDK_ENDPOINT=beta-sdk.aivin.vn:50052           # staging - dedicated Cloudflare Tunnel TLS port,
#                                                 # NOT the same setup production's LB uses
# SDK_ENDPOINT=localhost:50051                   # local BE (host.docker.internal:50051 if your
#                                                 # plugin runs inside Docker and BE runs on the host)

# Force TLS on/off for SDK_ENDPOINT - only needed if the auto-detection (TLS for anything that
# isn't a local/loopback/container-internal address) picks the wrong one for your setup.
# SDK_GRPC_TLS=false

# Per-call auth secret for the gRPC SDK channel - normally injected automatically inside a
# deployed container, not something you set by hand locally.
# SDK_SECRET=
